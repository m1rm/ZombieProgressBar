<idea-plugin>
    <id>com.m1rm.zombieprogressbar</id>
    <name>ZombieProgressBar</name>
    <vendor url="https://github.com/m1rm">Miriam Müller</vendor>
    <description><![CDATA[
    A zombie progress bar for IntelliJ and JetBrains IDEs. Replaces the default progress bar with a walking zombie.
    <p><img src="https://raw.githubusercontent.com/m1rm/ZombieProgressBar/main/src/main/resources/barScreenshot.png" alt="Zombie progress bar preview" width="600"/></p>
  ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <applicationListeners>
        <listener class="com.m1rm.zombieprogressbar.ZombieProgressListener" topic="com.intellij.ide.ui.LafManagerListener"/>
        <listener class="com.m1rm.zombieprogressbar.ZombieProgressListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>
    <extensions defaultExtensionNs="com.intellij">
    </extensions>
</idea-plugin>